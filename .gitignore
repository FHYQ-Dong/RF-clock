# .claude/ holds settings that stay on each machine and skills that belong to the repository
.claude/*
!.claude/skills/

# python
__pycache__/
.pytest_cache/

# Vivado batch build outputs
PL/build/
vivado.jou
vivado.log
PL/ip/*.vivado.log
PL/ip/*/project/
PL/ip/*/metadata/
.Xil/

# PL simulation test vectors written to the working directory
/*.hex

# Generated H09 simulation reports and waveform data
PL/data/*.html
PL/data/*.csv
PL/data/*.png

# Syncthing
.stfolder/
.stignore
~syncthing~*

# Local editor and tool settings (kept only on this machine)
.sigasi/
.vscode/
.editorconfig
project.sigasi

# AI-tools
.playwright-mcp
.codegraph/
.cursor/

# Results
results/

# PDFs of the technical report and their LaTeX files (tools/build_report.ps1)
/build/

# vendor data sheets and manuals used for the board designs (not ours to redistribute)
hw/ref/

# archives of the board folders made by hand
hw/*.zip

# plan 1 of the OCXO board, given up on 2026-11-20 (hw/ocxo_board is the board)
hw/ocxo_carrier/

# KiCad's lock files while a project is open
~*.lck
